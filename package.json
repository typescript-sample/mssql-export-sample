{
  "name": "typescript-starter",
  "version": "1.0.0",
  "description": "A basic typescript app starter for newbies in 2022.",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --exec ts-node-dev src/app",
    "build": "webpack --config webpack.config.js",
    "dev": "nodemon --exec ts-node-dev src/app",
    "prod": "node dist/app",
    "compile": "rimraf ./build && tsc"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run test && npm run prettier-format && npm run lint"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "config-plus": "^0.1.1",
    "export-kit": "^0.1.7",
    "logger-core": "^0.5.2",
    "mssql": "^12.7.0",
    "mssql-core": "^0.2.0",
    "onecore": "^0.6.2"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "nodemon": "^3.1.14",
    "ts-loader": "^9.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
